# ==============================================================================
# GST Online Seller Integration - Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Generate strong, cryptographically secure random keys for SECRET_KEY and JWT_SECRET_KEY:
#    e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
# 3. Fill in PostgreSQL and Redis credentials.
# 4. NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Core Application Configuration
FLASK_CONFIG=production
PORT=5000
SECRET_KEY=change_me_to_a_random_32_byte_hex_string
JWT_SECRET_KEY=change_me_to_a_random_32_byte_hex_string
SQL_ECHO=False

# PostgreSQL 16 Database Configuration
POSTGRES_USER=gst_seller
POSTGRES_PASSWORD=change_me_to_a_secure_database_password
POSTGRES_DB=gst_seller_db
DATABASE_URL=postgresql://gst_seller:change_me_to_a_secure_database_password@postgres:5432/gst_seller_db

# Redis 7 & Celery Asynchronous Job Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage & Processing Limits
MAX_CONTENT_LENGTH=524288000
CHUNK_SIZE=10000
MAX_ROWS_PER_FILE=500000
DEFAULT_FINANCIAL_YEAR=2024-25
